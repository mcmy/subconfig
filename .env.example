# Published multi-platform GHCR image for mcmy/subconfig.
# For local builds, use: SUBCONFIG_IMAGE=subconfig:local
SUBCONFIG_IMAGE=ghcr.io/mcmy/subconfig:latest

# Required. Generate with: openssl rand -hex 32
SUBCONFIG_SECRET=

# Bind to loopback by default. Use 0.0.0.0 for direct remote access.
SUBCONFIG_BIND_ADDRESS=127.0.0.1
SUBCONFIG_PORT=25500
